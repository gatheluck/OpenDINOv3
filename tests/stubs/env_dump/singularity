#!/usr/bin/env python3
"""Stands in for `singularity exec`, recording only the environment it was
handed. The real stub runs the command; this one must not, because the
command is a full download."""
import os, sys

args = sys.argv[1:]
if not args or args[0] != "exec":
    sys.exit(f"expected `exec`, got {args[:1]}")
pairs, i = [], 1
while i < len(args):
    if args[i] == "--env":
        pairs.append(args[i + 1]); i += 2
    elif args[i] == "--bind":
        i += 2
    else:
        break
# Whatever remains must be the image and the command. If a line continuation
# was broken, this is empty and the job would have run nothing.
rest = args[i:]
with open(os.environ["OD_ENV_DUMP"], "w") as handle:
    handle.write("\n".join(pairs) + "\n---\n" + " ".join(rest) + "\n")
